# Copy to .env then edit. run.sh loads it automatically. Never commit .env.
ATHAR_ADMIN_USERNAME=admin
ATHAR_ADMIN_PASSWORD=            # 12-256 chars, used only on first run (empty DB)
PORT=8780
# LLM: rules = fully local rule-based assistant (no keys). codex = codex CLI login. openai_compat = OpenRouter/OpenAI-compatible.
LLM_PROVIDER=rules
# CODEX_HOME=~/.codex
# OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# FORECAST_ENGINE=auto   # auto | stat | timesfm
# ATHAR_SECURE_COOKIE=1  # when served over HTTPS
